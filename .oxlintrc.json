{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "node", "promise", "import"],
  "jsPlugins": ["@e18e/eslint-plugin", "@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error",
    "import/no-named-export": "error",
    "import/no-absolute-path": "error",
    "import/no-relative-parent-imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Use the TypeScript path alias, such as #/utils/foo."
          }
        ]
      }
    ],
    "typescript/no-misused-spread": "off",
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "block-like",
        "next": "*"
      }
    ],
    // e18e mondernization
    "e18e/prefer-array-at": "error",
    "e18e/prefer-array-fill": "error",
    "e18e/prefer-includes": "error",
    "e18e/prefer-array-to-reversed": "error",
    "e18e/prefer-array-to-sorted": "error",
    "e18e/prefer-array-to-spliced": "error",
    "e18e/prefer-nullish-coalescing": "error",
    "e18e/prefer-object-has-own": "error",
    "e18e/prefer-spread-syntax": "error",
    "e18e/prefer-url-canparse": "error",
    // e18e module replacements
    "e18e/ban-dependencies": "error",
    // e18e performance improvements
    "e18e/prefer-array-from-map": "error",
    "e18e/prefer-timer-args": "error",
    "e18e/prefer-date-now": "error",
    "e18e/prefer-regex-test": "error",
    "e18e/prefer-array-some": "error",
    "e18e/prefer-static-regex": "error",
    "e18e/prefer-string-fromcharcode": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", "src/renderer/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["src/renderer/routes/*.tsx"],
      "rules": { "import/no-named-export": "off" }
    },
    {
      "files": ["packages/db/src/*.ts"],
      "rules": {
        "import/no-named-export": "off",
        "no-restricted-imports": "off"
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
