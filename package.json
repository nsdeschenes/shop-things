{
  "name": "@shop-things",
  "version": "0.3.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types index.ts",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:packages": "pnpm --parallel --filter @shop-things/contract --filter @shop-things/db dev",
    "build": "node --experimental-strip-types scripts/build.ts",
    "dist:mac": "pnpm build && pnpm --filter electron exec electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "pnpm build && pnpm --filter electron exec electron-builder --win nsis --x64 --publish never",
    "dist:linux": "pnpm dist:linux:arm64",
    "dist:linux:x64": "pnpm build && pnpm --filter electron exec electron-builder --linux deb --x64 --publish never",
    "dist:linux:arm64": "pnpm build && pnpm --filter electron exec electron-builder --linux deb --arm64 --publish never",
    "fix": "nub run lint:fix && nub run fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pre-commit:run": "prek run",
    "pre-commit:install": "prek install",
    "test": "node --experimental-strip-types scripts/test.ts",
    "test:scripts": "tsc -p scripts/tsconfig.test.json && vitest run --config scripts/vitest.config.ts",
    "typecheck": "node --experimental-strip-types scripts/typecheck.ts",
    "test:watch": "node --experimental-strip-types scripts/test-watch.ts",
    "prepare:backend": "node --experimental-strip-types scripts/prepare.ts",
    "test:renderer": "pnpm build && node acceptance/buildHarness.mjs && playwright test --config acceptance/playwright.config.ts"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@j178/prek": "^0.5.3",
    "@playwright/test": "^1.63.0",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^26",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^9.2.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7",
    "vitest": "^5.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
