{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^\\.\\.(?!/?$)",
    "^\\.\\./?$",
    "",
    "^\\./(?=.*/)(?!/?$)",
    "^\\.(?!/?$)",
    "^\\./?$",
    ""
  ],
  "sortImports": true,
  "bracketSpacing": false,
  "bracketSameLine": false,
  "printWidth": 90,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "arrowParens": "avoid",
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules", "repos", "CHANGELOG.md"],
  "objectWrap": "preserve"
}
