{
  "name": "electron",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node ../../scripts/tasks.mjs start",
    "dev": "node ../../scripts/tasks.mjs dev",
    "build:main": "node ../../scripts/tasks.mjs electron-build",
    "test": "node ../../scripts/tasks.mjs electron-test",
    "test:watch": "node ../../scripts/tasks.mjs electron-watch",
    "test:smoke": "node ../../scripts/tasks.mjs electron-smoke",
    "build:preload": "node ../../scripts/tasks.mjs preload-build"
  },
  "dependencies": {
    "@shop-things/contract": "workspace:*",
    "@shop-things/db": "workspace:*"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^26",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "typescript": "^7",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.shopthings.app",
    "productName": "Shop Things",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../db/migrations",
        "to": "migrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
