{
  "name": "electron",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "pnpm run build:main && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:main": "tsc --noEmit false --allowImportingTsExtensions false --rootDir src --outDir dist --incremental false",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsc -p tsconfig.test.json && vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@shop-things/db": "workspace:*"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^26",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.shopthings.app",
    "productName": "Shop Things",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../db/migrations",
        "to": "migrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
