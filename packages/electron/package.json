{
  "name": "electron",
  "version": "0.3.1",
  "description": "Customer records and saved database workflows",
  "homepage": "https://github.com/nsdeschenes/shop-things",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node --experimental-strip-types ../../scripts/start.ts",
    "dev": "node --experimental-strip-types ../../scripts/dev.ts",
    "typecheck": "node --experimental-strip-types ../../scripts/typecheck.ts electron",
    "build:main": "node --experimental-strip-types ../../scripts/electron-build.ts",
    "test": "node --experimental-strip-types ../../scripts/electron-test.ts",
    "test:watch": "node --experimental-strip-types ../../scripts/test-watch.ts",
    "test:smoke": "node --experimental-strip-types ../../scripts/electron-smoke.ts",
    "build:preload": "node --experimental-strip-types ../../scripts/preload-build.ts"
  },
  "dependencies": {
    "@shop-things/contract": "workspace:*",
    "@shop-things/db": "workspace:*"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^26",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "extends": "update/build-config.cjs",
    "appId": "com.shopthings.app",
    "productName": "Shop Things",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../db/migrations",
        "to": "migrations",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "update/restart-supervisor.py",
        "to": "update/restart-supervisor.py"
      },
      {
        "from": "update",
        "to": "update",
        "filter": [
          "policy.json",
          "identity.json",
          "updater-helper.py",
          "transaction.py",
          "recovery.py",
          "resolve-update",
          "apt-hook",
          "bootstrap.py",
          "com.shopthings.app.update.policy",
          "ELECTRON-BUILDER-LICENSE"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "packageName": "shop-things",
      "afterInstall": "update/after-install.tpl",
      "afterRemove": "update/after-remove.tpl",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "python3 (>= 3.9)",
        "python3-gi",
        "python3-apt",
        "gir1.2-gtk-3.0",
        "pkexec | policykit-1",
        "polkitd | policykit-1",
        "apt",
        "dpkg",
        "openssl",
        "acl",
        "libglib2.0-bin"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Shop Things contributors <nsdeschenes@users.noreply.github.com>",
      "executableName": "shop-things"
    },
    "beforePack": "update/before-pack.cjs",
    "afterPack": "update/after-pack.cjs"
  }
}
