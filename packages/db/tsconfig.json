{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Drizzle declaration errors; see docs/agents/declarationChecking.md.
    "skipLibCheck": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "incremental": false
  },
  "include": ["src"]
}
