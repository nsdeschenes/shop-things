{
  "name": "@shop-things/db",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "node --experimental-strip-types ../../scripts/typecheck.ts db",
    "test": "pnpm build && tsc -p tsconfig.test.json && vitest run",
    "migrations:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrations:check": "drizzle-kit check --config drizzle.config.ts",
    "migrations:apply": "pnpm build && node scripts/applyMigrations.mjs",
    "test:watch": "pnpm build && vitest"
  },
  "dependencies": {
    "@tursodatabase/database": "0.7.2",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vitest": "^5.0.2"
  }
}
